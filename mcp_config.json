{
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "env": {
        "PUPPETEER_HEADLESS": "true",
        "PUPPETEER_DEFAULT_VIEWPORT_WIDTH": "1920",
        "PUPPETEER_DEFAULT_VIEWPORT_HEIGHT": "1080"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "env": {
        "CHROME_STARTUP_TIMEOUT": "20000"
      }
    }
  }
}
